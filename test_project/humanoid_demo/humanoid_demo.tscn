[sub_resource type="Shader" id="FloorGrid"]
code = "shader_type spatial;

void fragment() {
	vec2 cell = abs(fract(UV * 80.0 - 0.5) - 0.5);
	float line = 1.0 - smoothstep(0.012, 0.026, min(cell.x, cell.y));
	ALBEDO = mix(vec3(0.24, 0.28, 0.31), vec3(0.42, 0.47, 0.51), line);
	ROUGHNESS = 1.0;
}
"

